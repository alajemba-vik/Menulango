platform :ios, '15.0'

# The shared Compose framework is still built by Gradle. This pod belongs only to the Swift app
# shell, where it translates diner notes on-device.
use_frameworks! :linkage => :static

target 'iosApp' do
  # ML Kit 7+ requires iOS 15.5. Keep the app's existing iOS 15.0 support baseline.
  pod 'GoogleMLKit/Translate', '6.0.0'
end
