// Shared build settings for the iOS app. Personal values live in Secrets.xcconfig (git-ignored);
// copy Secrets.xcconfig.example to get started. The app builds and runs without it.
TEAM_ID=

PRODUCT_NAME=MenuLango
PRODUCT_BUNDLE_IDENTIFIER=com.menulango.app

CURRENT_PROJECT_VERSION=2
MARKETING_VERSION=1.0.0

// The Kotlin framework is static, so the system SQLite that SQLDelight uses is linked here.
OTHER_LDFLAGS=$(inherited) -lsqlite3

PROXY_URL=
REVENUECAT_IOS_KEY=

#include? "Secrets.xcconfig"
