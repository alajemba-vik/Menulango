// Copy to Secrets.xcconfig (git-ignored) and fill in.
// xcconfig treats "//" as a comment, so write the URL with $() between the slashes.
TEAM_ID=ABCDE12345
PROXY_URL=https:/$()/menulango-proxy.your-subdomain.workers.dev
REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
FIREBASE_IOS_APP_ID=1:123456789012:ios:abcdef0123456789
FIREBASE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIREBASE_PROJECT_ID=menulango
// Optional: RevenueCat Test Store key for Debug builds only. Never used by TestFlight or the App Store.
REVENUECAT_TEST_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxx
